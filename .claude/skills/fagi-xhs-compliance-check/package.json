    "违禁词",
    "合规检测",
    "敏感词",
    "广告法",
    "发布前检查",
    "OCR"
  ],
  "license": "MIT",
  "agent": {
    "type": "skill",
    "skill_name": "xhs-compliance-check",
    "triggers": [
      "违禁词检测",
      "合规检查",
      "小红书检测",
      "敏感词检测",
      "发布前检查",
      "帮我查违禁词",
      "审稿",
      "广告法检测"
    ]
  }
}
